* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    min-height: 100vh;
    background: #f4f6fb;
    display: flex;
    align-items: center;
    justify-content: center;
}

.container {
    width: 1000px;
    min-height: 620px;
    display: flex;
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.08);
}

.left-side {
    width: 42%;
    background: #172554;
    color: white;
    padding: 55px 40px;
    display: flex;
    flex-direction: column;
}

.logo {
    font-size: 30px;
    font-weight: bold;
    color: #60a5fa;
    margin-bottom: 100px;
}

.left-side h1 {
    font-size: 43px;
    line-height: 1.2;
    margin-bottom: 20px;
}

.left-side p {
    color: #cbd5e1;
    line-height: 1.7;
    font-size: 15px;
}

.footer-text {
    margin-top: auto;
    color: #94a3b8;
    font-size: 12px;
}

.right-side {
    width: 58%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.login-box {
    width: 100%;
    max-width: 390px;
}

.login-box h2 {
    font-size: 30px;
    color: #172554;
    margin-bottom: 10px;
}

.subtitle {
    color: #64748b;
    margin-bottom: 30px;
    font-size: 14px;
}

.role-selection {
    display: flex;
    gap: 15px;
    margin-bottom: 30px;
}

.role-btn {
    flex: 1;
    padding: 18px 10px;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    background: white;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    transition: 0.3s;
}

.role-btn span {
    font-size: 27px;
}

.role-btn strong {
    color: #172554;
    font-size: 15px;
}

.role-btn small {
    color: #64748b;
    font-size: 11px;
    text-align: center;
}

.role-btn.active {
    border-color: #2563eb;
    background: #eff6ff;
}

.login-box label {
    display: block;
    margin-bottom: 8px;
    margin-top: 18px;
    color: #334155;
    font-size: 14px;
    font-weight: bold;
}

.login-box input {
    width: 100%;
    padding: 14px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    outline: none;
    font-size: 14px;
}

.login-box input:focus {
    border-color: #2563eb;
}

.login-btn {
    width: 100%;
    padding: 15px;
    margin-top: 25px;
    background: #2563eb;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

.login-btn:hover {
    background: #1d4ed8;
}

.register-text {
    text-align: center;
    margin-top: 25px;
    font-size: 13px;
    color: #64748b;
}

.register-text a {
    color: #2563eb;
    text-decoration: none;
    font-weight: bold;
}

@media (max-width: 750px) {
    .container {
        width: 95%;
        flex-direction: column;
    }

    .left-side {
        width: 100%;
        padding: 30px;
    }

    .logo {
        margin-bottom: 30px;
    }

    .left-side h1 {
        font-size: 32px;
    }

    .right-side {
        width: 100%;
        padding: 30px 20px;
    }
}